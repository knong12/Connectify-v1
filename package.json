{
  "name": "connectify-v2",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace api",
    "build": "npm run build --workspace web && npm run build --workspace api"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.27.2": true
  }
}
