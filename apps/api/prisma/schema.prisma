generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SpotifyTimeRange {
  short_term
  medium_term
  long_term
}

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  displayName          String
  spotifyUserId        String              @unique
  spotifyProfileImage  String?
  bio                  String?
  favoriteArtistNote   String?
  musicPrompt          String?
  spotifyAccessToken   String?
  spotifyRefreshToken  String?
  spotifyConnected     Boolean             @default(false)
  spotifyScopes        String[]            @default([])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  following            Follow[]            @relation("UserFollowing")
  followers            Follow[]            @relation("UserFollowers")
  favoriteArtists      UserFavoriteArtist[]
  favoriteTracks       UserFavoriteTrack[]
  conversationsAsA     Conversation[]      @relation("ConversationMemberA")
  conversationsAsB     Conversation[]      @relation("ConversationMemberB")
  sentMessages         Message[]
  ownedMixes           MixSave[]           @relation("MixOwner")
  featuredMixes        MixSave[]           @relation("MixTarget")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Artist {
  id        String               @id @default(uuid())
  spotifyId String               @unique
  name      String
  imageUrl  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  users     UserFavoriteArtist[]
}

model Track {
  id         String              @id @default(uuid())
  spotifyId  String              @unique
  name       String
  artistName String
  albumName  String?
  albumArt   String?
  previewUrl String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  users      UserFavoriteTrack[]
}

model UserFavoriteArtist {
  id        String   @id @default(uuid())
  userId    String
  artistId  String
  rank      Int
  timeRange SpotifyTimeRange @default(medium_term)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId, timeRange])
  @@unique([userId, rank, timeRange])
}

model UserFavoriteTrack {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  rank      Int
  timeRange SpotifyTimeRange @default(medium_term)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId, timeRange])
  @@unique([userId, rank, timeRange])
}

enum ConversationStatus {
  mutual
  pending
  accepted
  declined
}

model Conversation {
  id          String   @id @default(uuid())
  memberAId   String
  memberBId   String
  status      ConversationStatus @default(mutual)
  requesterId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberA     User     @relation("ConversationMemberA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberB     User     @relation("ConversationMemberB", fields: [memberBId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([memberAId, memberBId])
  @@index([memberAId, updatedAt])
  @@index([memberBId, updatedAt])
}

model Message {
  id                Int          @id @default(autoincrement())
  conversationId    String
  senderId          String
  clientMessageId   String
  body              String
  createdAt         DateTime     @default(now())
  readAt            DateTime?
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, id])
  @@index([conversationId, readAt])
}

model MixSave {
  id                String   @id
  ownerId           String
  targetUserId      String
  name              String
  trackIds          String[]
  status            String   @default("prepared")
  spotifyPlaylistId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             User     @relation("MixOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  target            User     @relation("MixTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}
